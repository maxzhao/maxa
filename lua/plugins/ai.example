local env = require("maxa.utils.env")
local DEFAULT_OPENAI_ADAPTER = "deepseek"
local DEFAULT_OPENAI_MODEL = "deepseek-v4-flash"
local DEFAULT_OPENAI_COMPACT_MODEL = "deepseek-v4-flash"
-- "ultra", "max", "xhigh", "high", "medium", "low", "none"
local DEFAULT_OPENAI_THINKING_MODE = "xhigh"
local DEFAULT_HTTP_RAW = {
  "--http1.1",
  "--retry",
  "5",
  "--retry-delay",
  "2",
  "--retry-max-time",
  "150",
  "--connect-timeout",
  "30",
  "--speed-limit",
  "1",
  "--speed-time",
  "60",
}
return {
  {
    dir = vim.fn.stdpath("config"),
    name = "maxa",
    lazy = false,
    init = require("maxa.session.nvim_restart_resume").setup,
    keys = {
      {
        "<leader>aC",
        function()
          vim.fn.feedkeys(":Maxa", "n")
        end,
        desc = "Maxa AI",
        mode = { "n", "v" },
      },
      { "<leader>ac", "<Cmd>Maxa<CR>", desc = "Maxa", mode = "n" },
      { "<leader>ac", "<Cmd>Maxa Add<CR>", desc = "Maxa", mode = "v" },
      {
        "<leader>aA",
        function()
          require("maxa.session.adapter_ui").select_global()
        end,
        desc = "Maxa AI: Set global LLM/media defaults",
      },
      {
        "<leader>aa",
        function()
          require("maxa.session.adapter_ui").select_project()
        end,
        desc = "Maxa AI: Set project LLM/media defaults",
      },
      { "<leader>ah", "<Cmd>MaxaHistory<CR>", desc = "MaxaHistory" },
      {
        "<leader>aN",
        function()
          require("maxa.session.notify_when_done").toggle_default()
        end,
        desc = "Toggle Maxa AI completion listener default",
      },
    },
    opts = {
      maxa = {
        protocol_defaults = {
          openai_responses = {
            default_model = DEFAULT_OPENAI_MODEL,
            compact_model = DEFAULT_OPENAI_COMPACT_MODEL,
            models = { fallback = { [DEFAULT_OPENAI_MODEL] = {} } },
            raw = DEFAULT_HTTP_RAW,
            thinking_mode = DEFAULT_OPENAI_THINKING_MODE,
          },
          anthropic_messages = { default_model = "claude-opus-5.5", raw = DEFAULT_HTTP_RAW },
          openai_compatible = { raw = DEFAULT_HTTP_RAW },
          gemini = { raw = DEFAULT_HTTP_RAW },
        },
        defaults = {
          chat = "main",
          compact = {
            adapter = DEFAULT_OPENAI_ADAPTER,
            model = DEFAULT_OPENAI_MODEL,
            thinking_mode = DEFAULT_OPENAI_THINKING_MODE,
