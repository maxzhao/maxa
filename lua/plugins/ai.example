    dependencies = {
      "nvim-lua/plenary.nvim",
      "nvim-treesitter/nvim-treesitter",
      {
        "MeanderingProgrammer/render-markdown.nvim",
        ft = { "markdown", "maxa_ai" },
      },
      {
        "HakonHarnes/img-clip.nvim",
        opts = {
          filetypes = {
            maxa_ai = {
              prompt_for_file_name = false,
              template = "[Image]($FILE_PATH)",
              use_absolute_path = true,
            },
          },
        },
      },
      -- blink.cmp integration
      {
        "saghen/blink.cmp",
        opts = {
          sources = {
            per_filetype = {
              maxa_ai = { "maxa_ai" },
            },
          },
        },
      },
      {
        "nvim-lualine/lualine.nvim",
        event = "VeryLazy",
        opts = function(_, opts)
          local cc_status_lualine = require("maxa.session.status.lualine")
          local cc_details_component = {
            cc_status_lualine.details_status,
            cond = cc_status_lualine.has_display_chat,
            on_click = function()
              cc_status_lualine.refresh()
            end,
            __maxa_ai_status = true,
          }
          local cc_notify_component = {
            cc_status_lualine.notify_icon,
            cond = cc_status_lualine.has_display_chat,
            color = function()
              return cc_status_lualine.notify_hl_group()
            end,
            on_click = function()
              cc_status_lualine.toggle_notify()
            end,
            __maxa_ai_status = true,
          }
          local cc_spinner_component = {
            cc_status_lualine.spinner_status,
            cond = cc_status_lualine.cond,
            color = function()
              return cc_status_lualine.hl_group()
            end,
            on_click = function()
              cc_status_lualine.refresh()
            end,
            __maxa_ai_status = true,
          }

          table.insert(opts.sections.lualine_y, 1, cc_details_component)
          table.insert(opts.sections.lualine_y, 1, cc_notify_component)
          table.insert(opts.sections.lualine_y, 1, cc_spinner_component)
        end,
      },
    },
  },
}
