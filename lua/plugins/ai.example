          summary = "light_text",
          translate = "light_text",
          title = "light_text",
          image = {},
          tts = {},
          video = {},
        },
        presets = {
          main = {
            type = "chat",
            adapter = DEFAULT_OPENAI_ADAPTER,
            model = DEFAULT_OPENAI_MODEL,
            visible = true,
            description = "Complex reasoning, coding, and detailed investigation.",
