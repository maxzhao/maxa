        providers = {
          deepseek = {
            type = "deepseek",
            base_url = "https://api.deepseek.com",
            api_key = env.get("DEEPSEEK_API_KEY"),
            quota = true,
            llm = {
              openai_responses = {
                name = "deepseek",
                formatted_name = "Deepseek",
                unsupported_parameters = {},
                extend = require("maxa.adapters.http.openai_responses_extensions.deepseek").extend,
                schema = { model = { default = "deepseek-v4-flash", choices = { ["deepseek-v4-flash"] = {} } } },
                maxa = { compact = { adapter = "inherit", model = "deepseek-v4-flash" } },
              },
            },
          },
