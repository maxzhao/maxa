# maxa 运行时配置示例（目标项目 <root>/.maxa/runtime.yaml 模板）
# 完整字段参考见 docs/runtime-config.md。
# 凭据只按环境变量名引用（api_key_env），值从进程环境读取，不落盘。

schema_version: 1
project_id: my-project

# ---- provider：真实 LLM 通道（不配置时本地 mock/echo 仍可用）----
provider:
  # 未显式指定 provider 时使用的定义 id
  default: deepseek-chat
  definitions:
    # OpenAI Chat Completions 通道
    deepseek-chat:
      protocol: openai_chat
      base_url: https://api.deepseek.com
      api_key_env: DEEPSEEK_API_KEY          # 环境变量名（禁字面量密钥）
      model: deepseek-v4-flash
      context_window: 128000                 # 可选；context-stop 用量比例按此计算
      capabilities:                          # 可选；未声明项按协议默认
        vision: false
        tools: true
        reasoning: true
      request:                               # 可选
        timeout_ms: 60000
        connect_timeout_ms: 10000
        retries: 0
        proxy_env: HTTPS_PROXY               # 代理 env 名；null = 显式无代理

    # OpenAI Responses 通道
    deepseek-responses:
      protocol: openai_responses
      base_url: https://api.deepseek.com
      api_key_env: DEEPSEEK_API_KEY
      model: deepseek-v4-flash

    # Anthropic Messages 通道
    deepseek-anthropic:
      protocol: anthropic_messages
      base_url: https://api.deepseek.com/anthropic
      api_key_env: DEEPSEEK_API_KEY
      model: deepseek-v4-flash

    # Gemini 原生通道（禁止走 OpenAI 兼容端点）
    # gemini:
    #   protocol: gemini
    #   base_url: https://generativelanguage.googleapis.com/v1beta
    #   api_key_env: GEMINI_API_KEY
    #   model: gemini-2.5-flash

# ---- orchestrator：会话状态机/自动工具循环（阶段 2 已消费）----
orchestrator:
  tool_concurrency: 1                         # 工具批并发；当前仍顺序执行（>1 阶段 3 激活）
  watchdog:                                   # 请求卡死看护
    enabled: false                            # 默认关闭
    timeout_ms: 180000                        # 无进展观察窗口（毫秒）
    max_retries: 3                            # 看护自动重试预算；手动提交重置；耗尽→单次终端失败
  context_stop:                               # 上下文用量自动刹车（一次性）
    enabled: true
    target: "80%"                             # 绝对 80 / "80%"；相对 "+10"；usage 不可用 fail-closed

# ---- ui：Chat 视图（layout/show_reasoning 已消费）----
ui:
  layout: vertical                            # vertical | horizontal | float | buffer
  show_reasoning: true                        # 显示推理折叠行（### Reasoning）
  # start_in_insert_mode: true                # 预留（阶段 5）
  # spinner_delay_ms: 300                     # 预留（阶段 5）
  # fold_reasoning: true                      # 预留（阶段 5）

