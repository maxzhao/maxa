# Maxa local environment example
#
# Copy this file to `.env` and fill local-only values there.
# `.env` is ignored by git; this example file is safe to commit.
# Keep real API keys, access tokens, account IDs, and machine-specific secrets out of source code.

# -----------------------------------------------------------------------------
# SHARED PROXY ADDRESSES (only explicitly enabled consumers use these values)
# These fields do not enable proxying or export variables to every process.
# -----------------------------------------------------------------------------

ALL_PROXY=
HTTP_PROXY=
HTTPS_PROXY=

# -----------------------------------------------------------------------------
# Local HTTPS upload and shared certificate management
# -----------------------------------------------------------------------------

# Certificate-backed DNS hostname; leave empty for loopback-only HTTP upload.
# Certificate status/renew/paths require a nonempty value.
# Both consumers read process env first, then MAXA_ENV_FILE or the runtime .env.
MAXA_CERT_DOMAIN=

# -----------------------------------------------------------------------------
# LLM HTTP adapter API keys
# -----------------------------------------------------------------------------

# API key for the `deepseek` adapter.
DEEPSEEK_API_KEY=

# -----------------------------------------------------------------------------
# GenAI MCP image provider tests
# -----------------------------------------------------------------------------

# Optional API key override for genai image provider tests.
# Leave empty in normal use; tests fall back to a fake local value.
GENAI_TEST_API_KEY=

# -----------------------------------------------------------------------------
# Telegram Bridge local runtime
# -----------------------------------------------------------------------------

# Disabled by default. Set to 1 locally to enable the Neovim Lua client hooks.
MAXA_TELEGRAM_BRIDGE_ENABLED=0

# Local FastAPI bridge endpoint. The service should listen on localhost only.
MAXA_TELEGRAM_BRIDGE_URL=http://127.0.0.1:8765
MAXA_TELEGRAM_BRIDGE_HOST=127.0.0.1
MAXA_TELEGRAM_BRIDGE_PORT=8765

# Local shared secret for Neovim -> bridge HTTP API.
MAXA_TELEGRAM_BRIDGE_TOKEN=

# Telegram Bot API configuration for the Python bridge service and human-assist scripts.
# `MAXA_TELEGRAM_CHAT_ID` is accepted as a legacy alias for GROUP_ID where applicable.
MAXA_TELEGRAM_BOT_TOKEN=
MAXA_TELEGRAM_GROUP_ID=
MAXA_TELEGRAM_OWNER_USER_ID=
MAXA_TELEGRAM_SQLITE_PATH=
MAXA_TELEGRAM_HEARTBEAT_TTL=90
MAXA_TELEGRAM_POLL_TIMEOUT=30
